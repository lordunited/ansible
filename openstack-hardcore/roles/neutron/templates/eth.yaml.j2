network:
  version: 2
  ethernets:
    {{ neutron_provider_nic }}:
      dhcp4: false
  bridges:
    {{ neutron_provider_bridge }}:
      interfaces:
        - {{ neutron_provider_nic }}
      openvswitch: {}
      addresses:
        - "{{ neutron_provider_ip }}/{{ neutron_provider_prefix }}"
      dhcp4: false
      parameters:
        stp: false
