[DEFAULT]
transport_url = rabbit://{{ rabbitmq_username }}:{{ rabbitmq_password }}@{{ rabbitmq_address }}
core_plugin = {{ neutron_core_plugin }}
service_plugins = {{ neutron_service_plugins }}
auth_strategy = {{ neutron_auth_strategy }}

[agent]
root_helper = {{ neutron_root_helper }}

[keystone_authtoken]
www_authenticate_uri = http://{{ keystone_address }}:{{ keystone_port }}
auth_url = http://{{ keystone_address }}:{{ keystone_port }}
memcached_servers = {{ memcached_adddress }}:{{ memcached_port }}
auth_type = {{ neutron_auth_type }}
project_domain_name = {{ openstack_domain }}
user_domain_name = {{ openstack_domain }}
project_name = {{ openstack_project }}
username = {{ neutron_keystone_user }}
password = {{ neutron_keystone_password }}

[oslo_concurrency]
lock_path = {{ neutron_lock_path }}
