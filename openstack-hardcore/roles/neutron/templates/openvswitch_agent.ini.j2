[agent]
tunnel_types = {{ neutron_tunnel_types }}
l2_population = {{ neutron_l2_population }}

[ovs]
integration_bridge = {{ neutron_integration_bridge }}
tunnel_bridge = {{ neutron_tunnel_bridge }}
local_ip = {{ host_ip }}
bridge_mappings = {{ neutron_physical_network }}:{{ neutron_provider_bridge }}

[securitygroup]
enable_security_group = {{ neutron_enable_security_group }}
firewall_driver = {{ neutron_firewall_driver }}
