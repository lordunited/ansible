network:
  version: 2
  ethernets:
    {{ neutron_mgmt_nic }}:
      addresses:
        - "{{ host_ip }}/{{ neutron_mgmt_prefix }}"
      nameservers:
        addresses:
{% for dns in neutron_dns_servers %}
          - {{ dns }}
{% endfor %}
      dhcp4: false
      routes:
        - to: default
          via: {{ neutron_mgmt_gateway }}
    {{ neutron_provider_nic }}:
      dhcp4: false
      dhcp6: false
  bridges:
    {{ neutron_provider_bridge }}:
      interfaces:
        - {{ neutron_provider_nic }}
      openvswitch: {}
      addresses:
        - "{{ neutron_provider_ip }}/{{ neutron_provider_prefix }}"
      dhcp4: false
